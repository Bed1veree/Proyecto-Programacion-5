# ========================================
# VARIABLES DE ENTORNO - BACKEND
# ========================================
# Copiar este archivo a .env y completar con valores locales
# NUNCA commit .env con valores reales

# ========================================
# ENTORNO GENERAL
# ========================================
NODE_ENV=development

# ========================================
# SERVIDOR EXPRESS
# ========================================
BACKEND_PORT=3001
BACKEND_HOST=localhost

# ========================================
# BASE DE DATOS - POSTGRESQL
# ========================================
DATABASE_URL=postgresql://biblioteca_user:password123@localhost:5432/biblioteca_universitaria
DB_HOST=localhost
DB_PORT=5432
DB_USER=biblioteca_user
DB_PASSWORD=password123
DB_NAME=biblioteca_universitaria

# ========================================
# AUTENTICACIÓN - JWT
# ========================================
JWT_SECRET=tu_clave_secreta_super_segura_aqui_minimo_32_caracteres
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=tu_clave_refresh_diferente_minimo_32_caracteres
JWT_REFRESH_EXPIRE=30d

# ========================================
# CORS
# ========================================
CORS_ORIGIN=http://localhost:3000

# ========================================
# POLÍTICAS DE LA BIBLIOTECA
# ========================================
MAX_LOAN_DAYS=14
MAX_RENEWALS=1
FINE_PER_DAY=1000
NOTIFICATION_DAYS_BEFORE=2

# ========================================
# SEGURIDAD
# ========================================
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15

